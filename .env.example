# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# ── Provider switch ───────────────────────────────────────────────────────────
# Set to 'gemini' or 'claude' to select which model to use.
AICORE_PROVIDER=gemini

# ── Gemini deployment ─────────────────────────────────────────────────────────
AICORE_BASE_URL_GEMINI=https://<your-ai-core-host>/v2/inference/deployments/<gemini-deployment-id>
AICORE_MODEL_GEMINI=gemini-2.5-pro

# ── Claude deployment (SAP AI Core, Anthropic Messages API via /invoke) ───────
AICORE_BASE_URL_CLAUDE=https://<your-ai-core-host>/v2/inference/deployments/<claude-deployment-id>
AICORE_MODEL_CLAUDE=claude-opus-4-8

# ── Shared AI Core credentials ────────────────────────────────────────────────
AICORE_CLIENT_ID=<your-client-id>
AICORE_CLIENT_SECRET=<your-client-secret>
AICORE_TOKEN_URL=https://<your-xsuaa-host>/oauth/token
AICORE_RESOURCE_GROUP=default

# ── Mock SAP S/4HANA system ───────────────────────────────────────────────────
S4_BASE_URL=http://localhost:3001/sap/opu/odata/sap/API_SALES_ORDER_SRV
MOCK_S4_PORT=3001
