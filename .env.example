# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# SAP AI Core — Gemini 2.5 Pro deployment
AICORE_BASE_URL=https://<your-ai-core-host>/v2/inference/deployments/<deployment-id>
AICORE_CLIENT_ID=<your-client-id>
AICORE_CLIENT_SECRET=<your-client-secret>
AICORE_TOKEN_URL=https://<your-xsuaa-host>/oauth/token
AICORE_MODEL=gemini-2.5-pro
AICORE_RESOURCE_GROUP=default

# Mock SAP S/4HANA system
S4_BASE_URL=http://localhost:3001/sap/opu/odata/sap/API_SALES_ORDER_SRV
MOCK_S4_PORT=3001
